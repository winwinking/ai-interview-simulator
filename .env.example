# 复制成 .env 并填自己的值。app.py 只从 .env 读，不硬编码。
DB_HOST=localhost
DB_PORT=3306
DB_NAME=interview_db
DB_USER=root
DB_PASSWORD=your_password_here

# 可选：配了就不用每次在网页上填 key（没配的话，第一次用会在网页上弹框要求输入，
# 只存在服务进程内存里，不写文件）。
DEEPSEEK_API_KEY=

# 必填：题库仓库根目录（含 docs/ 的那一层），题库内容不随本项目分发，自己去克隆/下载。
# 仓库地址见 README「题库数据来源」。
QUESTION_BANK_DIR=C:\path\to\ai-agent-interview-guide

# 可选：只有从旧的 JSON 文件存储版本升级、要跑 migrate_json_to_mysql.py 时才需要，
# 指向那 6 个旧 JSON 文件（wrong_answers.json 等）所在目录。
LEGACY_JSON_DIR=C:\path\to\old\json\files
